package com.example.lilnuggy;

import net.fabricmc.api.ModInitializer;
import net.fabricmc.fabric.api.event.player.UseEntityCallback;
import net.fabricmc.fabric.api.event.player.UseItemCallback;
import net.minecraft.ChatFormatting;
import net.minecraft.core.component.DataComponents;
import net.minecraft.network.chat.Component;
import net.minecraft.server.level.ServerLevel;
import net.minecraft.sounds.SoundEvents;
import net.minecraft.sounds.SoundSource;
import net.minecraft.util.Mth;
import net.minecraft.world.InteractionHand;
import net.minecraft.world.InteractionResult;
import net.minecraft.world.entity.EquipmentSlot;
import net.minecraft.world.entity.item.ItemEntity;
import net.minecraft.world.entity.item.PrimedTnt;
import net.minecraft.world.entity.animal.golem.IronGolem;
import net.minecraft.world.item.ItemStack;
import net.minecraft.world.item.Items;
import net.minecraft.world.phys.Vec3;
import net.minecraft.world.scores.PlayerTeam;
import net.minecraft.world.scores.Scoreboard;

public class LilNuggy implements ModInitializer {
    private static final String RED_TEAM = "lilnuggy_red_glow";

    @Override
    public void onInitialize() {
        // ---- Throw small lit TNT ----
        UseItemCallback.EVENT.register((player, level, hand) -> {
            ItemStack stack = player.getItemInHand(hand);
            if (!stack.is(Items.TNT)) return InteractionResult.PASS;
            if (!(level instanceof ServerLevel server)) return InteractionResult.SUCCESS;

            PrimedTnt tnt = new PrimedTnt(server, player.getX(), player.getEyeY() - 0.1, player.getZ(), player);
            tnt.setFuse(80);                       // usual fuse
            tnt.setGlowingTag(true);               // glowing
            tnt.setDeltaMovement(player.getLookAngle().scale(1.2));
            // Small explosion: PrimedTnt stores a float explosion power (default 4.0).
            // If your 26.3 mappings expose a setter, call it here, e.g. tnt.setExplosionPower(2.0F);

            // Red glow = scoreboard team colour
            Scoreboard sb = server.getScoreboard();
            PlayerTeam team = sb.getPlayerTeam(RED_TEAM);
            if (team == null) {
                team = sb.addPlayerTeam(RED_TEAM);
                team.setColor(ChatFormatting.RED);
            }
            sb.addPlayerToTeam(tnt.getScoreboardName(), team);

            server.addFreshEntity(tnt);
            server.playSound(null, player.blockPosition(), SoundEvents.TNT_PRIMED, SoundSource.PLAYERS, 1f, 1f);
            if (!player.getAbilities().instabuild) stack.shrink(1);
            return InteractionResult.SUCCESS;
        });

        // ---- Shear a golem into "Lil nuggy" ----
        UseEntityCallback.EVENT.register((player, level, hand, entity, hit) -> {
            ItemStack held = player.getItemInHand(hand);
            if (!(entity instanceof IronGolem golem) || !held.is(Items.SHEARS)) return InteractionResult.PASS;
            if (!(level instanceof ServerLevel server)) return InteractionResult.SUCCESS;

            ItemStack nugget = new ItemStack(Items.IRON_NUGGET);
            nugget.set(DataComponents.CUSTOM_NAME, Component.literal("Lil nuggy"));

            ItemEntity drop = new ItemEntity(server, golem.getX(), golem.getY() + golem.getBbHeight() * 0.6,
                    golem.getZ(), nugget);
            drop.setGlowingTag(true);
            drop.setCustomNameVisible(true);
            drop.setDeltaMovement(new Vec3(
                    (server.random.nextDouble() - 0.5) * 0.2,
                    0.35 + server.random.nextDouble() * 0.15,   // positive Y: pops out
                    (server.random.nextDouble() - 0.5) * 0.2));
            server.addFreshEntity(drop);

            golem.discard();
            server.playSound(null, golem.blockPosition(), SoundEvents.SHEEP_SHEAR, SoundSource.PLAYERS, 1f, 1f);
            held.hurtAndBreak(1, player, hand == InteractionHand.MAIN_HAND
                    ? EquipmentSlot.MAINHAND : EquipmentSlot.OFFHAND);
            return InteractionResult.SUCCESS;
        });
    }
}
{
  "schemaVersion": 1,
  "id": "lilnuggy",
  "version": "1.0.0",
  "name": "Lil Nuggy",
  "description": "Throwable glowing small TNT and shearable iron golems.",
  "environment": "*",
  "entrypoints": {
    "main": ["com.example.lilnuggy.LilNuggy"]
  },
  "depends": {
    "fabricloader": "*",
    "minecraft": "*",
    "fabric-api": "*"
  }
}
